rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: any authenticated Petrus user.
    function signedIn() {
      return request.auth != null;
    }
    function isFiorella() {
      return signedIn() && request.auth.token.email == 'fiorella@petrus.local';
    }
    function isManager() {
      return signedIn() && (request.auth.token.email == 'fiorella@petrus.local'
                         || request.auth.token.email == 'milena@petrus.local');
    }

    // Dishes: any signed-in user can read; Fiorella and Milena can write.
    match /dishes/{dishId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // Home notes with one or more recipients (array `recipients`).
    //  - 'all' in recipients  → any signed-in team member can read
    //  - an email in recipients → only those people, the author, or Fiorella
    //  Create/edit: Fiorella & Milena. Delete: Fiorella only.
    match /notes/{noteId} {
      allow read: if signedIn() && (
                     isFiorella()
                  || (resource.data.recipients is list && (
                        resource.data.recipients.hasAny(['all'])
                     || resource.data.recipients.hasAny([request.auth.token.email])
                     ))
                  || resource.data.authorEmail == request.auth.token.email
                  );
      allow create, update: if isManager();
      allow delete: if isFiorella();
    }

    // Admins registry: signed-in users may read (admin.html checks membership);
    // writes only via the Admin SDK (service account), never from the client.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Access logs: signed-in users may create their own log entries; no edits.
    match /access_logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // ── Push notifications (independent layer) ─────────────────────────
    // Device tokens: a signed-in user may register/update/remove their own
    // device token. The actual sending is done by Cloud Functions using the
    // Admin SDK, which bypasses these rules.
    match /push_tokens/{token} {
      allow read: if false; // tokens are private; only the backend reads them
      allow create, update: if signedIn()
                            && request.resource.data.email == request.auth.token.email;
      allow delete: if signedIn()
                    && resource.data.email == request.auth.token.email;
    }

    // Manual broadcast messages written from admin.html. Fiorella creates
    // them; a Cloud Function reacts and sends the push to everyone.
    match /notifications/{noteId} {
      allow read: if signedIn();
      allow create: if isFiorella();
      allow update, delete: if false;
    }

    // Bookings: any signed-in user can read and write.
    match /bookings/{bookingId} {
      allow read, write: if signedIn();
    }

    // Rota: any signed-in user can read and write.
    match /rota_weeks/{weekId} {
      allow read, write: if signedIn();
    }

    // Sommelier operations collections: any signed-in user can read and write.
    match /somm_stock/{docId}            { allow read, write: if signedIn(); }
    match /somm_deliveries/{docId}       { allow read, write: if signedIn(); }
    match /somm_wastages/{docId}         { allow read, write: if signedIn(); }
    match /somm_transfers/{docId}        { allow read, write: if signedIn(); }
    match /somm_duties/{docId}           { allow read, write: if signedIn(); }
    match /somm_messages/{docId}         { allow read, write: if signedIn(); }
    match /somm_holidays/{docId}         { allow read, write: if signedIn(); }
    match /somm_holiday_entries/{docId}  { allow read, write: if signedIn(); }
    match /somm_daily_notes/{docId}      { allow read, write: if signedIn(); }
    match /somm_recipes/{docId}          { allow read, write: if signedIn(); }
    match /somm_pairings/{docId}         { allow read, write: if signedIn(); }
    match /somm_stocktake/{docId}        { allow read, write: if signedIn(); }
    match /product_catalog/{docId}       { allow read, write: if signedIn(); }
    match /viniv_reports/{docId}         { allow read, write: if signedIn(); }

    // Everything else stays locked unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
