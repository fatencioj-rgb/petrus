rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dishes: any signed-in user can read; only Fiorella can write.
    match /dishes/{dishId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'fiorella@petrus.local';
    }

    // Access logs: signed-in users may create their own log entries; no edits.
    match /access_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Everything else stays locked unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
